# Banco de dados. Sem isto, o app usa o adaptador local do navegador e diz isso na tela.
DATABASE_URL="postgresql://user:password@localhost:5432/mestrexadrez?schema=public"

# Segredo de assinatura da sessão. Mínimo 16 caracteres.
# Em produção, gere um valor aleatório: `openssl rand -base64 32`
AUTH_SECRET="troque-este-valor-antes-de-subir"
